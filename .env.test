NODE_ENV=test
TZ=Asia/Shanghai
PORT=13333
HOST=127.0.0.1
LOG_LEVEL=warn
REQUEST_LOG_BODY=false
REQUEST_LOG_MAX_BODY_BYTES=65536

APP_KEY=test-app-key-for-wechat-ilink-api
APP_URL=http://127.0.0.1:13333

SESSION_DRIVER=memory
LIMITER_STORE=memory
ILINK_APP_ID=bot
ILINK_APP_CLIENT_VERSION=132104
ILINK_CHANNEL_VERSION=2.4.8
ILINK_BOT_AGENT=OpenClaw
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_BOT_TYPE=3
DEFAULT_TEST_ACCOUNT_ENABLED=true
DEFAULT_TEST_ACCOUNT_EMAIL=test@example.com
DEFAULT_TEST_ACCOUNT_PASSWORD=test12345678
DEFAULT_TEST_ACCOUNT_NAME=Test Developer
DB_DATABASE=tmp/test.sqlite3
