# 微信 iLink API 环境变量模板
#
# 使用方式：
#   cp .env.example .env
#
# APP_KEY、数据库文件和 Webhook secret 属于敏感数据，请勿提交到代码仓库。

#--------------------------------------------------------------------
# 1. 服务运行环境
#--------------------------------------------------------------------
TZ=Asia/Shanghai
NODE_ENV=development
HOST=localhost
PORT=13333
APP_URL=http://${HOST}:${PORT}

#--------------------------------------------------------------------
# 2. 应用安全
#--------------------------------------------------------------------
# 请使用随机值；服务运行后不要随意更换。
APP_KEY=

#--------------------------------------------------------------------
# 3. 数据存储
#--------------------------------------------------------------------
# SQLite 文件路径。Docker Compose 会将项目目录 ./data 映射到容器内。
DB_DATABASE=data/db.sqlite3
# 出站媒体本地持久化目录。相对路径以项目根目录为基准。
MEDIA_STORAGE_PATH=data/media

#--------------------------------------------------------------------
# 4. 日志
#--------------------------------------------------------------------
# 日志级别：trace、debug、info、warn、error、fatal。
LOG_LEVEL=info
# 是否记录请求和响应正文。敏感字段会自动脱敏。
REQUEST_LOG_BODY=true
# 单条请求或响应正文的最大日志字节数，超出后保留截断预览。
REQUEST_LOG_MAX_BODY_BYTES=65536

#--------------------------------------------------------------------
# 5. 会话与访问控制
#--------------------------------------------------------------------
# API 限流存储：database 或 memory。
LIMITER_STORE=database

# 浏览器会话存储：cookie、memory 或 database。
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# 6. 微信服务连接
#--------------------------------------------------------------------
# 通常保持默认值。只有服务地址或协议版本发生变化时才需要调整。
ILINK_APP_ID=bot
ILINK_APP_CLIENT_VERSION=132104
ILINK_CHANNEL_VERSION=2.4.8
ILINK_BOT_AGENT=OpenClaw
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_BOT_TYPE=3

#--------------------------------------------------------------------
# 7. 开发测试账号
#--------------------------------------------------------------------
# 仅在非 production 环境生效。生产环境不会自动创建该账号。
DEFAULT_TEST_ACCOUNT_ENABLED=true
DEFAULT_TEST_ACCOUNT_EMAIL=test@example.com
DEFAULT_TEST_ACCOUNT_PASSWORD=test12345678
DEFAULT_TEST_ACCOUNT_NAME=Test Developer

#--------------------------------------------------------------------
# 8. 跨域访问
#--------------------------------------------------------------------
# 开发环境默认允许跨域；生产环境默认不开放跨域访问。
# 如需开放浏览器前端访问，请在应用跨域配置中设置允许的来源。
